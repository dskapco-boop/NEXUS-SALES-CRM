{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "clean": {
      "cache": false
    },
    "postinstall": {
      "cache": false
    }
  },
  "globalEnv": ["DATABASE_URL", "SUPABASE_URL", "SUPABASE_ANON_KEY", "MCP_SERVER_URL"]
}
