{
  "name": "nexus-crm",
  "description": "Cross-platform CRM for Nexus Comprehensive Solutions FZC",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:admin": "cd apps/admin && npx vite build --mode production",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "dev:admin": "cd apps/admin && vite --port 3000 --host 0.0.0.0 --open",
    "dev:mobile": "expo start --cwd apps/mobile",
    "functions:serve": "supabase functions serve"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.420.0",
    "pg": "^8.23.0",
    "react": "18.2.0",
    "react-dom": "^18.3.0",
    "react-native": "0.74.5",
    "react-router-dom": "^6.25.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^51.0.0",
    "expo-router": "^3.5.24",
    "expo-status-bar": "~57.0.1",
    "nativescript": "^8.8.1",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "^4.10.0",
    "react-native-screens": "^3.31.1",
    "supabase": "^1.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
