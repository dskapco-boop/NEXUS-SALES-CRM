{
  "name": "nexus-sales-crm",
  "description": "NEXUS SALES CRM - Cross-platform B2B sales CRM for Nexus Trading & Consultancy (UAE)",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "cd apps/admin && vite --port 5174 --host",
    "dev:mobile": "expo start --cwd apps/mobile",
    "build": "turbo run build",
    "build:admin": "cd apps/admin && npx vite build --mode production",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "functions:serve": "supabase functions serve"
  },
  "devDependencies": {
    "supabase": "^1.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1"
  }
}
