# Nexus CRM Environment Configuration
# Zero-Cost B2B Sales CRM for General Trading & ISO Consultancy

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OmniRoute AI Gateway (Local)
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_MODEL=captian
OMNIROUTE_FAST_MODEL=auto/best-fast

# Google Drive API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_DRIVE_QMS_FOLDER_ID=your-qms-folder-id
GOOGLE_DRIVE_INVOICES_FOLDER_ID=your-invoices-folder-id
GOOGLE_DRIVE_REPORTS_FOLDER_ID=your-reports-folder-id
GOOGLE_DRIVE_QUOTES_FOLDER_ID=your-quotes-folder-id
GOOGLE_DRIVE_ORDERS_FOLDER_ID=your-orders-folder-id
GOOGLE_DRIVE_AUDITS_FOLDER_ID=your-audits-folder-id

# Email (SendGrid - Free Tier: 100 emails/day)
SENDGRID_API_KEY=your-sendgrid-api-key

# App Settings
APP_NAME=Nexus CRM
APP_URL=http://localhost:5173
COMPANY_NAME=Nexus Trading & Consultancy
DEFAULT_CURRENCY=AED
VAT_RATE=5
COMPANY_LOGO=/logo.png
TIMEZONE=Asia/Dubai

# Mobile App
PUSH_NOTIFICATION_PUBLIC_KEY=your-vapid-public-key

# Feature Flags
ENABLE_OFFLINE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
